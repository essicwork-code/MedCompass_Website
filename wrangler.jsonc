{
  /*
   * Cloudflare Workers "static assets" deployment — not the OpenNext/SSR
   * path. The site itself has no server (next.config.ts sets output:
   * "export"), so `assets` still just uploads the prerendered `out/` folder.
   *
   * `main` now points at a small Worker (worker/index.ts) that exists only
   * to handle POST /api/book for the booking-modal email flow; every other
   * request falls through to `env.ASSETS.fetch()`, which is the same static
   * serving behaviour (including the custom 404 page) as before this file
   * had a `main` at all. If that Worker is ever removed, drop `main` and
   * `assets.binding` together and this reverts to a pure static-assets
   * deployment — no OpenNext adapter gets involved either way, since that
   * only triggers off Cloudflare's own "Next.js" framework auto-detection,
   * which an explicit `assets` block always bypasses.
   */
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ride-medcompass-website",
  "compatibility_date": "2026-07-31",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
