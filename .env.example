# Cookieless analytics. Leave unset and components/Analytics.tsx renders
# nothing, so local builds and forks measure nobody.
#
# Cloudflare Web Analytics (free, cookieless, works on GitHub Pages):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://static.cloudflareinsights.com/beacon.min.js
#
# Plausible (richer conversion events):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=ridemedcompass.com
#
# Umami (self-hosted):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://your-umami-host/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=ridemedcompass.com
#
# Set these as repository variables so the deploy workflow can pass them to the
# build. Never put a key or anything rider-identifying in here: NEXT_PUBLIC_*
# is compiled into the client bundle and is public by definition.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
