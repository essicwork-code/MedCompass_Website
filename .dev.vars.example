# Copy this file to .dev.vars (already gitignored) for local `wrangler dev`
# testing of worker/index.ts. Never commit real values.

# Required. Resend API key used to send booking notification/confirmation
# emails from POST /api/book. Without it, the endpoint responds with a clean
# 500 error instead of attempting to send.
RESEND_API_KEY=

# Optional. Overrides the "from" address on both booking emails. Falls back
# to Resend's shared sandbox sender ("MedCompass <onboarding@resend.dev>")
# if unset, which works without domain verification but can only deliver to
# the Resend account owner's own address — a verified sending domain is
# needed to email arbitrary riders in production.
RESEND_FROM_EMAIL=
